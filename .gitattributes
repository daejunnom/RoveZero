# Keep authored documentation stable across Windows and cloud checkouts.
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.py text eol=lf
Cargo.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Unified-diff context blank lines contain a required space; keep patch bytes exact.
experiments/baselines/*.patch text eol=lf -whitespace
experiments/baselines/bt4-final-selection-openings-v3.json -text

# Preserve the supplied handoff snapshots byte for byte.
docs/reference/PlyZero_Handoff_v0.1.0_KO.md -text
docs/reference/RoveZero_Handoff_v0.2.0_KO.md -text

# Locked fixtures use exact byte digests across Windows and Linux checkouts.
experiments/**/fixtures/** -text
crates/**/tests/fixtures/** -text
