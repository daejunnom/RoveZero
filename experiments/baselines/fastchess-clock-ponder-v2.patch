+std::optional<std::string> UciEngine::rzPonderMove() const {
+    const auto lines = getStdoutLines();
+    if (lines.empty()) return std::nullopt;
+    const auto result = str_utils::findElement<std::string>(str_utils::splitString(lines.back()->line, ' '), "ponder");
+    return result.has_value() ? std::optional<std::string>(*result) : std::nullopt;
+}
+bool UciEngine::rzStopPonder(std::chrono::milliseconds timeout) {
+    if (!rz_ponder_prediction) return true;
+    setupReadEngine();
+    const bool valid = writeEngine("stop") && readEngineLowLat("bestmove", timeout).code == process::Status::OK;
+    rz_ponder_prediction.reset();
+    LOG_TRACE_THREAD("RZ_PONDER_V1 engine={} event=stop valid={}", config_.name, valid);
+    return valid;
+}
